SLACK_BOT_TOKEN=xoxb-seu-bot-token
SLACK_APP_TOKEN=xapp-seu-app-token

# Define a engine de LLM (antigravity, codex, mock). O padrão é antigravity.
LLM_ENGINE=antigravity

# Ative somente durante diagnóstico supervisionado; não envia logs ao Slack.
SLACK_BRIDGE_DEBUG=0

# (Opcional) Filtra os eventos do bot para responder apenas num canal específico
# Útil para rodar múltiplos bots no mesmo workspace para projetos diferentes.
SLACK_CHANNEL_ID=
